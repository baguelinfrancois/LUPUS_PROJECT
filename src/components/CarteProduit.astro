---
// Carte produit compacte : photo, nom, prix. Toute la carte mène à la fiche,
// où se trouve le bouton « Acheter sur HelloAsso ».
// La carte « vedette » (premier produit d'un drop) est plus grande et garde son bouton.
import { Image } from 'astro:assets';
import { datesDuDrop, type Drop, type Produit } from '../lib/contenu';
import { calculerEtat, si, zoneDrop, LIBELLES_ETAT } from '../lib/etat-drop';
import { prix } from '../lib/dates';
import BoutonAchat from './BoutonAchat.astro';

interface Props {
  produit: Produit;
  drop?: Drop;
  maintenant: number;
  vedette?: boolean;
}
const { produit, drop, maintenant, vedette = false } = Astro.props;
const p = produit.data;
const photo = p.photos[0];
const dates = drop ? datesDuDrop(drop) : undefined;
const etat = dates ? calculerEtat(dates, maintenant) : undefined;
const zone = dates && etat ? zoneDrop(dates, etat) : {};
const lienFiche = `/produits/${produit.id}`;
---

<article class:list={['carte', { 'carte--vedette': vedette }]} {...zone}>
  <a class="carte__lien" href={lienFiche}>
    <span class="carte__image">
      <Image
        src={photo.photo}
        alt=""
        widths={[240, 360, 540, 720, 1080]}
        sizes={vedette ? '(min-width: 48rem) 50vw, 100vw' : '(min-width: 64rem) 20vw, (min-width: 48rem) 25vw, 50vw'}
      />
      {
        etat ? (
          <>
            <span class="pastille" {...si(['avenir', 'teasing'], etat)}>{LIBELLES_ETAT.teasing}</span>
            <span class="pastille" {...si(['acces'], etat)}>{LIBELLES_ETAT.acces}</span>
            <span class="pastille pastille--epuise" {...si(['clos', 'archive'], etat)}>Épuisé</span>
          </>
        ) : (
          <>
            {p.statut === 'precommande' && <span class="pastille">Précommande</span>}
            {p.statut === 'epuise' && <span class="pastille pastille--epuise">Épuisé</span>}
          </>
        )
      }
    </span>
    <span class="carte__nom">{p.nom}</span>
    <span class="carte__prix">{prix(p.prix)}</span>
    {p.numerotation && <span class="carte__tirage">{p.numerotation}</span>}
  </a>
  {
    vedette && (
      <div class="carte__vedette">
        <p class="carte__desc">{p.description_courte}</p>
        <BoutonAchat produit={produit} drop={drop} etat={etat} />
      </div>
    )
  }
</article>

<style>
  .carte__lien {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }
  .carte__image {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--furtif);
    margin-bottom: 0.6rem;
  }
  .carte__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .carte__lien:hover .carte__image :global(img) {
    transform: scale(1.03);
  }
  .carte__lien:hover .carte__nom {
    text-decoration: underline;
  }
  /* Teasing : photo floutée jusqu'à l'accès anticipé */
  .carte[data-etat='teasing'] .carte__image :global(img),
  .carte[data-etat='avenir'] .carte__image :global(img) {
    filter: blur(14px) brightness(0.6);
  }
  .pastille {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    background: var(--nuit);
    color: var(--lampe);
    font-family: var(--police-ui);
    font-weight: 600;
    font-size: 0.8rem;
    line-height: 1;
    padding: 0.3rem 0.45rem;
    border-radius: var(--rayon);
  }
  .pastille--epuise {
    color: var(--alerte);
  }
  .carte__nom {
    font-family: var(--police-ui);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.2;
  }
  .carte__prix {
    font-family: var(--police-ui);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--stealth-texte);
    margin-top: 0.15rem;
  }
  .carte__tirage {
    font-size: 0.85rem;
    color: var(--stealth-texte);
  }

  .carte--vedette .carte__nom {
    font-family: var(--police-titre);
    font-weight: var(--poids-titre);
    font-size: clamp(1.8rem, 7vw, 2.5rem);
    line-height: 1;
  }
  .carte--vedette .carte__prix {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--lampe);
  }
  .carte__vedette {
    margin-top: 0.5rem;
  }
  .carte__desc {
    color: var(--stealth-texte);
    margin-bottom: 0.9rem;
  }
</style>
