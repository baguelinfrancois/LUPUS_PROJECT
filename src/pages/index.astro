---
// Accueil = le drop en cours. Le reste des produits est dans l'onglet Boutique.
import Base from '../layouts/Base.astro';
import HeroViseur from '../components/HeroViseur.astro';
import CarteProduit from '../components/CarteProduit.astro';
import { SITE } from '../config';
import { datesDuDrop, dropALaUne, produitALaUne, produitsDuDrop } from '../lib/contenu';
import { calculerEtat, si, zoneDrop } from '../lib/etat-drop';

const maintenant = Date.now();
const drop = await dropALaUne(maintenant);
const produitsDrop = drop ? await produitsDuDrop(drop.id) : [];
const produitPhare = drop ? produitsDrop[0] : await produitALaUne();
const dates = drop ? datesDuDrop(drop) : undefined;
const etat = dates ? calculerEtat(dates, maintenant) : undefined;
---

<Base>
  <HeroViseur drop={drop} produitPhare={produitPhare} maintenant={maintenant} />

  {
    drop && dates && etat && produitsDrop.length > 0 && (
      <section class="section pieces" aria-labelledby="titre-pieces" {...zoneDrop(dates, etat)}>
        <div class="conteneur">
          <div class="entete-section">
            <h2 id="titre-pieces">Les pièces du drop</h2>
            <a class="lien-fort" href={`/drops/${drop.id}`}>
              L'histoire <span aria-hidden="true">→</span>
            </a>
          </div>
          <ul class="grille-produits grille-produits--vedette">
            {produitsDrop.map((produit, i) => (
              <li>
                <CarteProduit produit={produit} drop={drop} maintenant={maintenant} vedette={i === 0} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section bandeau" aria-labelledby="titre-liste">
    <div class="conteneur bandeau__grille">
      <div>
        <h2 id="titre-liste">Liste privée</h2>
        <p>Le lien de chaque drop, avant l'ouverture publique. Un e-mail par drop, pas plus.</p>
      </div>
      <div class="boutons">
        <a class="bouton" href={SITE.listePrivee} data-suivi="inscription">Rejoindre la liste privée</a>
        <a class="bouton bouton--secondaire" href="/boutique">Toute la boutique</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .pieces {
    padding-top: 0;
  }
  .entete-section {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .entete-section h2 {
    margin: 0;
    font-size: clamp(1.8rem, 7vw, 2.75rem);
  }
  .lien-fort {
    font-family: var(--police-ui);
    font-weight: 600;
    font-size: 1.1rem;
    white-space: nowrap;
    padding-block: 0.5rem;
  }
  .bandeau {
    background: var(--furtif);
  }
  .bandeau__grille {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }
  @media (min-width: 48rem) {
    .bandeau__grille {
      grid-template-columns: 1fr auto;
      gap: 3rem;
    }
  }
  .bandeau h2 {
    font-size: clamp(1.8rem, 7vw, 2.75rem);
    margin-bottom: 0.4rem;
  }
  .bandeau p {
    color: #b9bec6;
    margin: 0;
  }
</style>
