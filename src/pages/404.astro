---
import Base from '../layouts/Base.astro';
---

<Base titre="Page introuvable">
  <section class="section">
    <div class="conteneur texte-long">
      <p class="marquage">Erreur 404</p>
      <h1>Rien à signaler ici.</h1>
      <p class="chapeau">Cette page n'existe pas, ou plus.</p>
      <div class="boutons">
        <a class="bouton" href="/">Retour à l'accueil</a>
        <a class="bouton bouton--secondaire" href="/boutique">Voir la boutique</a>
      </div>
    </div>
  </section>
</Base>
